include LICENSE pyproject.toml setup.py
recursive-include lib/meshvenn_engine *.py
include core/__init__.py core/image_mask.py core/native_loader.py
include core/native_scan.py core/native_scan_diagnostics.py
include core/projection_alignment.py core/projection_frame.py
recursive-include core/diagnostic_contracts *.py
recursive-include core/diagnostics_preflight *.py
recursive-include core/geometry_diagnostics *.py
recursive-include core/appearance_diagnostics *.py
recursive-include core/material_visibility *.py
exclude core/material_visibility/blender_backend.py
recursive-include core/native_bridge *.py
recursive-include core/projection_math *.py
recursive-include core/geometry_contracts *.py
recursive-include core/pipeline_contracts *.py
include docs/engine-library.md
global-exclude __pycache__ *.py[cod]
prune tests
prune native
prune implementations
prune extensions
prune operators
prune properties
prune ui
